diff --git a/src/quoting/summary.ts b/src/quoting/summary.ts
index 8702d5f..3ef69fb 100644
--- a/src/quoting/summary.ts
+++ b/src/quoting/summary.ts
@@ -1,6 +1,10 @@
-import type { Quote } from './quote.ts';
+import { QUOTE_VALID_DAYS, type Quote } from './quote.ts';
 
-// The one-line summary shown beside a quote.
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+// The one-line summary shown beside a quote, with the last day it can be accepted.
 export function summarise(quote: Quote): string {
-  return `Quote ${quote.id}: £${(quote.premiumPence / 100).toFixed(2)} a year`;
+  const expires = new Date(quote.createdAt.getTime() + QUOTE_VALID_DAYS * DAY_MS);
+  const premium = (quote.premiumPence / 100).toFixed(2);
+  return `Quote ${quote.id}: £${premium} a year, valid until ${expires.toISOString().slice(0, 10)}`;
 }
