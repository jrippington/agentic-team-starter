 // A clock fixed at one moment, for tests.
 export const fixedClock = (iso: string) => () => new Date(iso);
+
+// A date a number of days after another, for tests.
+export const addDays = (date: Date, days: number) => new Date(date.getTime() + days * 24 * 60 * 60 * 1000);
